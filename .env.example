# ClientFlow CRM - copy to `.env` and adjust. NEVER commit the real .env file.

# --- Django ---
# Required when DJANGO_DEBUG is false. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
# Browser origins allowed to call the API cross-origin (not needed when the SPA is served behind the same host/proxy)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
# Production only (DJANGO_DEBUG=false): redirect HTTP->HTTPS and enable HSTS. Set false only behind a TLS-terminating proxy
# that does not forward X-Forwarded-Proto, or for a plain-HTTP local Docker run.
DJANGO_SECURE_SSL_REDIRECT=true

# --- PostgreSQL ---
POSTGRES_DB=clientflow
POSTGRES_USER=clientflow
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Auth tuning (optional) ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
LOGIN_THROTTLE_RATE=10/min

# --- Demo data ---
# Password given to the fictional demo accounts by `manage.py seed_demo`.
DEMO_PASSWORD=ClientFlow-Demo-2026
